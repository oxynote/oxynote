{
	"name": "@oxynote/auth-realtime",
	"type": "module",
	"scripts": {
		"postinstall": "patch-package",
		"dev": "tsx --import ./src/instrument.ts watch src/index.ts",
		"build": "tsc",
		"start": "node --import ./dist/instrument.js dist/index.js",
		"docker-build": "docker buildx build --platform linux/amd64 --no-cache -t ghcr.io/oxynote/auth-realtime:dev -f ./docker/Dockerfile .",
		"check-types": "tsc --noEmit",
		"lint": "eslint --fix .",
		"check-lint": "eslint .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"qa": "npm run check-types && npm run check-lint && npm run check-fmt",
		"qa-fix": "npm run check-types && npm run lint && npm run fmt"
	},
	"dependencies": {
		"@better-auth/electron": "^1.6.11",
		"@hocuspocus/extension-logger": "^3.2.3",
		"@hocuspocus/server": "^3.2.2",
		"@hocuspocus/transformer": "^3.2.3",
		"@hono/node-server": "^1.19.0",
		"@hono/node-ws": "^1.2.0",
		"@sentry/node": "^10.39.0",
		"@tiptap/core": "^3.1.0",
		"@tiptap/extension-blockquote": "^3.1.0",
		"@tiptap/extension-bold": "^3.1.0",
		"@tiptap/extension-code": "^3.1.0",
		"@tiptap/extension-code-block-lowlight": "^3.3.0",
		"@tiptap/extension-document": "^3.1.0",
		"@tiptap/extension-heading": "^3.1.0",
		"@tiptap/extension-horizontal-rule": "^3.1.0",
		"@tiptap/extension-italic": "^3.1.0",
		"@tiptap/extension-link": "^3.1.0",
		"@tiptap/extension-list": "^3.2.0",
		"@tiptap/extension-paragraph": "^3.1.0",
		"@tiptap/extension-strike": "^3.1.0",
		"@tiptap/extension-text": "^3.1.0",
		"@tiptap/extension-underline": "^3.1.0",
		"@tiptap/extension-unique-id": "^3.14.0",
		"axios": "^1.11.0",
		"better-auth": "^1.6.11",
		"hono": "^4.9.2",
		"kysely": "^0.28.8",
		"lowlight": "^3.3.0",
		"nanoid": "^5.1.6",
		"pg": "^8.16.3",
		"redis": "^5.8.3",
		"yjs": "^13.6.27"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@types/node": "^20.11.17",
		"@types/pg": "^8.15.5",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"patch-package": "^8.0.1",
		"prettier": "3.6.2",
		"tsx": "^4.7.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.40.0"
	}
}
