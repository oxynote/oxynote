{
	"name": "@oxynote/auth-realtime",
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx watch --import ./src/sentry.ts src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"build:bundle": "esbuild src/bundle.ts --bundle --platform=node --format=esm --minify --external:pg-native --external:bufferutil --external:utf-8-validate \"--banner:js=import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/bundle.mjs",
		"start": "node --import ./dist/sentry.js dist/index.js",
		"check-types": "tsc --noEmit",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache",
		"check-knip": "knip --cache",
		"test": "vitest run --coverage",
		"test-watch": "vitest",
		"lint": "pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"dependencies": {
		"@better-auth/electron": "^1.7.2",
		"@better-auth/mcp": "^1.7.2",
		"@hocuspocus/extension-logger": "^4.8.0",
		"@hocuspocus/server": "^4.8.0",
		"@hocuspocus/transformer": "^4.8.0",
		"@hono/node-server": "^1.19.17",
		"@hono/node-ws": "^1.3.1",
		"@sentry/node": "^11.10.0",
		"@tiptap/core": "^3.32.1",
		"@tiptap/extension-blockquote": "^3.32.1",
		"@tiptap/extension-bold": "^3.32.1",
		"@tiptap/extension-code": "^3.32.1",
		"@tiptap/extension-code-block-lowlight": "^3.32.1",
		"@tiptap/extension-document": "^3.32.1",
		"@tiptap/extension-heading": "^3.32.1",
		"@tiptap/extension-horizontal-rule": "^3.32.1",
		"@tiptap/extension-italic": "^3.32.1",
		"@tiptap/extension-link": "^3.32.1",
		"@tiptap/extension-list": "^3.32.1",
		"@tiptap/extension-paragraph": "^3.32.1",
		"@tiptap/extension-strike": "^3.32.1",
		"@tiptap/extension-text": "^3.32.1",
		"@tiptap/extension-underline": "^3.32.1",
		"@tiptap/extension-unique-id": "^3.32.1",
		"axios": "^1.21.0",
		"better-auth": "^1.7.3",
		"hono": "^4.13.14",
		"jose": "^6.2.14",
		"kysely": "^0.29.7",
		"lowlight": "^3.3.0",
		"nanoid": "^6.0.2",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"redis": "^6.3.1",
		"yjs": "^13.6.33",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/eslint-plugin": "^1.6.28",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"knip": "^6.43.0",
		"prettier": "3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
