{
	"name": "@oxynote/auth-realtime",
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "tsx watch --import ./src/sentry.ts src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --import ./dist/sentry.js dist/index.js",
		"check-types": "tsc --noEmit",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache",
		"check-knip": "knip --cache",
		"test": "vitest run --coverage",
		"test-watch": "vitest",
		"lint": "pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"dependencies": {
		"@better-auth/electron": "^1.7.1",
		"@better-auth/mcp": "^1.7.1",
		"@hocuspocus/extension-logger": "^3.2.3",
		"@hocuspocus/server": "^3.2.2",
		"@hocuspocus/transformer": "^3.2.3",
		"@hono/node-server": "^1.19.0",
		"@hono/node-ws": "^1.3.1",
		"@sentry/node": "^10.70.0",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-blockquote": "^3.30.2",
		"@tiptap/extension-bold": "^3.30.2",
		"@tiptap/extension-code": "^3.30.2",
		"@tiptap/extension-code-block-lowlight": "^3.30.2",
		"@tiptap/extension-document": "^3.30.2",
		"@tiptap/extension-heading": "^3.30.2",
		"@tiptap/extension-horizontal-rule": "^3.30.2",
		"@tiptap/extension-italic": "^3.30.2",
		"@tiptap/extension-link": "^3.30.2",
		"@tiptap/extension-list": "^3.30.2",
		"@tiptap/extension-paragraph": "^3.30.2",
		"@tiptap/extension-strike": "^3.30.2",
		"@tiptap/extension-text": "^3.30.2",
		"@tiptap/extension-underline": "^3.30.2",
		"@tiptap/extension-unique-id": "^3.30.2",
		"axios": "^1.19.0",
		"better-auth": "^1.7.1",
		"hono": "^4.13.3",
		"jose": "^6.2.10",
		"kysely": "^0.29.5",
		"lowlight": "^3.3.0",
		"nanoid": "^5.1.6",
		"pg": "^8.23.0",
		"redis": "^5.8.3",
		"yjs": "^13.6.32",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@types/node": "^20.11.17",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"knip": "^6.32.2",
		"prettier": "3.9.6",
		"tsx": "^4.23.12",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
