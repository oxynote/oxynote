{"create_document":{"desc":"Create a document and return {document_id, branch_id}, the branch being its default one. It starts with one empty paragraph, so fill it with insert_blocks at position end on that branch.","has_params_one_of":true,"json_schema":{"properties":{"icon":{"default":"mingcute:document-2-fill","description":"An Iconify id from the icon picker, mostly MingCute fills such as mingcute:file-code-fill. Another id is refused, naming the closest ones.","type":"string"},"name":{"description":"The display name.","type":"string"},"parent_id":{"description":"The parent document id. Leave it out for the organisation root.","type":"string"}},"required":["name"],"type":"object"},"name":"create_document"},"create_hook":{"desc":"Add a freshness hook, such as a review reminder, to one branch of a document. Returns the hook as list_hooks does. A new hook starts untriggered. github-tracking and url-watcher need the deployment's GitHub App and changedetection.io integrations, so they are refused without them.","has_params_one_of":true,"json_schema":{"properties":{"block_uid":{"description":"The id of a block on the branch to anchor the hook to. Without it the hook covers the whole document.","type":"string"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"document_id":{"description":"The document id.","type":"string"},"settings":{"anyOf":[{"additionalProperties":false,"properties":{"schedule":{"description":"When the reminder is due, RFC 3339.","type":"string"},"type":{"const":"scheduled-reminder"}},"required":["type","schedule"],"type":"object"},{"additionalProperties":false,"properties":{"branch":{"description":"The branch to follow.","type":"string"},"paths":{"description":"The paths whose changes mark the document stale.","items":{"type":"string"},"minItems":1,"type":"array"},"repository":{"description":"The repository name, owned by the connected GitHub account.","type":"string"},"type":{"const":"github-tracking"}},"required":["type","repository","branch","paths"],"type":"object"},{"additionalProperties":false,"properties":{"type":{"const":"url-watcher"},"url":{"description":"The address to watch.","type":"string"}},"required":["type","url"],"type":"object"},{"additionalProperties":false,"properties":{"image":{"description":"The image reference to watch for new digests.","type":"string"},"type":{"const":"container-image-watcher"}},"required":["type","image"],"type":"object"}],"description":"The hook's type and its settings."}},"required":["document_id","branch_id","settings"],"type":"object"},"name":"create_hook"},"create_tag":{"desc":"Create a tag and return {tag_id}. The tag goes last in the sidebar order. update_tag moves it and set_tag_assignment puts it on a document. The name must be unused in the organisation.","has_params_one_of":true,"json_schema":{"properties":{"color":{"description":"The colour.","enum":["red","orange","amber","yellow","lime","green","emerald","teal","cyan","sky","blue","indigo","violet","purple","fuchsia","pink"],"type":"string"},"name":{"description":"The display name.","type":"string"}},"required":["name","color"],"type":"object"},"name":"create_tag"},"create_variable":{"desc":"Create a global variable, last in its group, and return {variable_id}. The key must be unused and match ^[a-z][a-z0-9_]*$. A list takes options, and the first is its default. Other types take a default, which a time range requires.","has_params_one_of":true,"json_schema":{"properties":{"default":{"description":"The value everyone sees until they pick their own: a decimal, a time range preset or text. Not for a list.","type":"string"},"description":{"description":"What the variable is for.","type":"string"},"group_id":{"description":"The variable group id, from list_variables.","type":"string"},"key":{"description":"The key, without the $.","type":"string"},"name":{"description":"The display name.","type":"string"},"options":{"description":"A list's option values in order.","items":{"type":"string"},"type":"array"},"type":{"description":"The kind of value.","enum":["list","number","text","time-range"],"type":"string"}},"required":["group_id","key","name","type"],"type":"object"},"name":"create_variable"},"create_variable_group":{"desc":"Create a variable group, last in order, and return {group_id}. The name must be unused.","has_params_one_of":true,"json_schema":{"properties":{"color":{"description":"The colour.","enum":["red","orange","amber","yellow","lime","green","emerald","teal","cyan","sky","blue","indigo","violet","purple","fuchsia","pink"],"type":"string"},"name":{"description":"The display name.","type":"string"}},"required":["name","color"],"type":"object"},"name":"create_variable_group"},"delete_block":{"desc":"Delete one block by id, with everything nested inside it. Returns {deleted: id}. Its comments, hooks and files go with it and cannot be restored. So to reorder blocks, use move_block instead, and to give a block new content, use replace_blocks.","has_params_one_of":true,"json_schema":{"properties":{"block_uid":{"description":"The id of the block to delete.","type":"string"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"document_id":{"description":"The document id.","type":"string"}},"required":["document_id","branch_id","block_uid"],"type":"object"},"name":"delete_block"},"delete_document":{"desc":"Delete a document and every document nested under it. Returns {document_id, deleted}. It cannot be restored, so check the tree with list_documents first. update_document moves a document instead.","has_params_one_of":true,"json_schema":{"properties":{"document_id":{"description":"The document id.","type":"string"}},"required":["document_id"],"type":"object"},"name":"delete_document"},"delete_hook":{"desc":"Delete a hook and stop its watch outside the document. Returns {hook_id, deleted}. It cannot be restored. update_hook without settings clears what it flagged instead. A protected branch keeps its hooks.","has_params_one_of":true,"json_schema":{"properties":{"document_id":{"description":"The document id.","type":"string"},"hook_id":{"description":"The hook id, from list_hooks.","type":"string"}},"required":["document_id","hook_id"],"type":"object"},"name":"delete_hook"},"delete_tag":{"desc":"Delete a tag from every document and branch. Returns {tag_id, deleted}. It cannot be restored. set_tag_assignment takes it off one document instead.","has_params_one_of":true,"json_schema":{"properties":{"tag_id":{"description":"The tag id, from list_tags or a document's tags.","type":"string"}},"required":["tag_id"],"type":"object"},"name":"delete_tag"},"delete_variable":{"desc":"Delete a global variable other than a built-in one, with everyone's value. Returns {variable_id, deleted}.","has_params_one_of":true,"json_schema":{"properties":{"variable_id":{"description":"The variable id, from list_variables.","type":"string"}},"required":["variable_id"],"type":"object"},"name":"delete_variable"},"delete_variable_group":{"desc":"Delete an empty variable group other than the built-in one. Returns {group_id, deleted}.","has_params_one_of":true,"json_schema":{"properties":{"group_id":{"description":"The variable group id, from list_variables.","type":"string"}},"required":["group_id"],"type":"object"},"name":"delete_variable_group"},"get_data_source_metadata":{"desc":"Describe what a data source holds. Prometheus gives each metric with its type, help and unit. Loki gives the labels its logs carried over the last hour, and list_log_fields with a query finds their other fields. SQL gives {default_schema, tables: {table: [columns]}}. Read it before writing a query, so the names in it are real.","has_params_one_of":true,"json_schema":{"properties":{"data_source_id":{"description":"The data source id, from list_data_sources.","type":"string"}},"required":["data_source_id"],"type":"object"},"name":"get_data_source_metadata"},"get_document":{"desc":"Read one document on one branch: its name, icon, parent_id, updated_at, its branches as [{id, name, protected, default, updated_at}], the tags on this branch, and content. content is its blocks as XML, one element per block with its id, in the format insert_blocks describes. Read a document this way before editing it.","has_params_one_of":true,"json_schema":{"properties":{"block_uid":{"description":"A block to narrow content to, with what it holds. An id inside a block, such as a search hit's, reads the block holding it.","type":"string"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document.","type":"string"},"document_id":{"description":"The document id.","type":"string"}},"required":["document_id","branch_id"],"type":"object"},"name":"get_document"},"insert_blocks":{"desc":"Insert new blocks, written as XML, at a document's start or end or beside the block reference_block_uid names. Returns the written blocks as XML with their ids. Every element is a new block, so leave out id, and use replace_blocks to change existing ones. A \u003cmetrics\u003e or \u003clogs\u003e goes in a \u003cgrid\u003e, beside one of its blocks or as a new grid. A block not allowed where it lands is refused, naming what that place takes.","has_params_one_of":true,"json_schema":{"properties":{"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"content":{"description":"The blocks as XML, one element per block, with all text inside an element such as \u003cp\u003e.\n- \u003cp\u003e holds text with inline marks. \u003ch1\u003e to \u003ch3\u003e hold plain text.\n- \u003cul\u003e and \u003col start\u003e hold \u003cli\u003e, and \u003ctasks\u003e holds \u003ctask checked\u003e. An entry holds its text, then any blocks nested under it.\n- \u003cblockquote\u003e and \u003ccallout icon\u003e hold blocks. A callout's icon takes the ids create_document's icon does.\n- \u003cpre language\u003e holds raw code. It takes a title only in a split_doc's \u003cright\u003e.\n- \u003cmermaid\u003e holds raw source. Mermaid ends a gantt task name or timeline period at its first colon, so write a colon inside one as #58;, never as \u0026#58;.\n- \u003chr/\u003e, \u003cimg src alt title width/\u003e and \u003cfigma src width height/\u003e are empty.\n- \u003cgrid\u003e sits at the top level and holds \u003cmetrics\u003e (a chart) and \u003clogs\u003e in the order the grid shows them, each a JSON object of attributes. A row fits 3 compact, 2 standard or 1 wide, never a standard beside a compact. Fill every row. A tall block spans two rows, and the blocks after it fill the space beside it. get_document shows three read-only attributes on each block: row and column, counted from 0 on 24 columns, and stack, its place in the one-column order of narrow pages. A \u003cgrid\u003e holds no text, so text about the charts, when there is some, goes in a block before it.\n- \u003csplit_doc inversed\u003e holds \u003cleft\u003e then \u003cright\u003e. \u003cleft\u003e has an \u003ch1\u003e, then \u003cp\u003e, lists or \u003ccallout\u003e, then any \u003cparams header\u003e of \u003cparam name type\u003edescription\u003c/param\u003e. \u003cright\u003e holds a titled \u003cpre\u003e, a \u003cmetrics\u003e or a \u003cmermaid\u003e.\nInline text takes \u003cb\u003e, \u003ci\u003e, \u003cu\u003e, \u003cs\u003e, \u003ccode\u003e and \u003ca href\u003e. Outside \u003cpre\u003e, \u003cmermaid\u003e, \u003cmetrics\u003e and \u003clogs\u003e, write \u0026 as \u0026amp; and \u003c as \u0026lt;. Inside them content is raw, but raw content with no \u003c at all is decoded as escaped text, so write a literal \u0026lt; there as \u0026amp;lt;.\nA metric block's attributes: dataSourceId (an id from list_data_sources), queries ([{name, query, legendFormat}], PromQL or SQL as the data source takes), height (standard|tall), refreshInterval ($metric_refresh|5s|10s|30s|1m|5m|15m|30m|1h|2h|1d), simulationPreset (cpu_usage|memory_usage|disk_usage|http_requests|http_latency|error_rate), timeRange ($metric_range|last_5_minutes|last_15_minutes|last_30_minutes|last_1_hour|last_3_hours|last_6_hours|last_12_hours|last_24_hours|last_2_days|last_7_days|last_30_days|last_90_days|last_6_months|last_1_year|last_2_years|last_5_years|today|yesterday|today_so_far|this_week|this_week_so_far|this_month|this_month_so_far|this_year|this_year_so_far|previous_week|previous_month|previous_year), unitType (custom|nanoseconds|microseconds|milliseconds|seconds|minutes|hours|days|bytes|kilobytes|megabytes|gigabytes|terabytes|bits|kilobits|megabits|gigabits|terabits|percent0to100|percent0to1), visualizationType (line_chart|bar_chart|gauge_chart), width (compact|standard|wide). It may also hold title, unitCustom (the label when unitType is custom), decimals, thresholds ([{value, label, color}]), baseThresholdColor, axisBoundsMin and axisBoundsMax. A threshold colour and baseThresholdColor are one of red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink. timeRange and refreshInterval default to $metric_range and $metric_refresh, the built-in variables each user sets. Give a preset only to pin one chart, and the reference to unpin it.\nA log block's attributes: dataSourceId, queries ([{name, query}]), timeRange, refreshInterval, width and height as a metric block's, order (desc|asc), timestampFormat (none|readable|readable_milli|readable_nano|readable_time|readable_time_milli|readable_time_nano|numeric|numeric_milli|numeric_nano|numeric_time|numeric_time_milli|numeric_time_nano). It may also hold title. order sorts the logs by time, and desc shows the newest first.","type":"string"},"document_id":{"description":"The document id.","type":"string"},"position":{"description":"Where the blocks land. before, after, above and below are taken against the reference block, and start and end against the whole document. above and below need a reference block in a \u003cgrid\u003e, where before and after are its left and right.","enum":["before","after","above","below","start","end"],"type":"string"},"reference_block_uid":{"description":"The id of the block to insert beside. Give it with before, after, above and below, and leave it out with start and end.","type":"string"}},"required":["document_id","branch_id","position","content"],"type":"object"},"name":"insert_blocks"},"list_data_sources":{"desc":"List the organisation's data sources as {id, name, type, status}. type is prometheus, loki, postgresql, supabase, mariadb or mysql. It decides the query language and which tools serve it, and loki holds logs. Start here, since the other data source tools take an id from this list.","has_params_one_of":true,"json_schema":{"properties":{},"type":"object"},"name":"list_data_sources"},"list_documents":{"desc":"List the organisation's documents as a tree of {id, name, branches: [{id, name, protected, default}], children}. To find a document by title or content, use search_documents instead.","has_params_one_of":true,"json_schema":{"properties":{"parent_id":{"description":"The document whose direct children to list. Without it the whole tree is listed.","type":"string"}},"type":"object"},"name":"list_documents"},"list_hooks":{"desc":"List the freshness hooks on one branch of a document as [{id, type, block_uid, settings, triggered, state, status, created_at, updated_at}]. A hook watches something outside the document. It triggers when that thing changes or a date passes. block_uid is the block it is anchored to, or null for the whole document.","has_params_one_of":true,"json_schema":{"properties":{"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document.","type":"string"},"document_id":{"description":"The document id.","type":"string"}},"required":["document_id","branch_id"],"type":"object"},"name":"list_hooks"},"list_log_fields":{"desc":"List the field names the logs of a Loki data source carry. With field, it lists that field's values instead, counted when the source counts them. Without query only labels and their values come back. A LogQL query narrows either list to the logs it matches and adds their other fields. Use it to find what a log query should filter on. A filter on a field parsed from a log needs a parser stage first: | json for JSON logs, | logfmt for key=value logs. detected_level and other structured metadata need no parser, but they are not labels, so filter them after the selector, as in | detected_level=\"error\".","has_params_one_of":true,"json_schema":{"properties":{"data_source_id":{"description":"The data source id, from list_data_sources.","type":"string"},"field":{"description":"A field, such as detected_level, whose values to list.","type":"string"},"from":{"description":"The range start, RFC 3339. Defaults to an hour before to.","type":"string"},"query":{"description":"A LogQL log query, such as {app=\"api\"}, whose logs to read the fields from.","type":"string"},"to":{"description":"The range end, RFC 3339. Defaults to now.","type":"string"}},"required":["data_source_id"],"type":"object"},"name":"list_log_fields"},"list_prometheus_labels":{"desc":"List the label names of a Prometheus data source or, with label, that label's values. matchers narrows either list to the series they select. Use it to find what a query should filter on.","has_params_one_of":true,"json_schema":{"properties":{"data_source_id":{"description":"The data source id, from list_data_sources.","type":"string"},"from":{"description":"The range start, RFC 3339. Defaults to an hour before to.","type":"string"},"label":{"description":"A label, such as job, whose values to list.","type":"string"},"matchers":{"description":"PromQL series selectors, such as [\"up\", \"{job=\\\"api\\\"}\"].","items":{"type":"string"},"type":"array"},"to":{"description":"The range end, RFC 3339. Defaults to now.","type":"string"}},"required":["data_source_id"],"type":"object"},"name":"list_prometheus_labels"},"list_prometheus_series":{"desc":"List the series that matchers select in a Prometheus data source, each as its full label set. Use it to see which label combinations a metric has before querying it.","has_params_one_of":true,"json_schema":{"properties":{"data_source_id":{"description":"The data source id, from list_data_sources.","type":"string"},"from":{"description":"The range start, RFC 3339. Defaults to an hour before to.","type":"string"},"matchers":{"description":"PromQL series selectors, such as [\"up\", \"{job=\\\"api\\\"}\"].","items":{"type":"string"},"minItems":1,"type":"array"},"to":{"description":"The range end, RFC 3339. Defaults to now.","type":"string"}},"required":["data_source_id","matchers"],"type":"object"},"name":"list_prometheus_series"},"list_tags":{"desc":"List the organisation's tags in sidebar order as [{id, name, color, documents}]. documents are the documents whose default branch carries the tag. A tag on another branch shows only in get_document for that branch.","has_params_one_of":true,"json_schema":{"properties":{},"type":"object"},"name":"list_tags"},"list_variables":{"desc":"List the global variables by group as [{id, name, color, builtin, variables: [{id, key, name, description, type, builtin, default, value, options}]}]. Queries and metrics reference a variable as $key, so one change updates every metric using it. Each user picks their own value. default is what anyone without one sees, and for a list it is its first option's id. value is the user's own, or null. A built-in's definition is fixed apart from its default, which update_variable sets. set_variable_value sets the user's own value.","has_params_one_of":true,"json_schema":{"properties":{},"type":"object"},"name":"list_variables"},"move_block":{"desc":"Move a block beside another block of the same document. Returns the moved block as XML. It keeps its id and nested content, and with them its comments, hooks and files, which a delete and insert would lose. A block not allowed where it lands is refused.","has_params_one_of":true,"json_schema":{"properties":{"block_uid":{"description":"The id of the block to move.","type":"string"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"document_id":{"description":"The document id.","type":"string"},"layout":{"default":"wide","description":"Which layout of a \u003cgrid\u003e the move changes. wide moves the block on the columns, and narrow pages follow until a stacked move gives them their own one-column order. stacked moves it only in that order, where above means before and below means after.","enum":["wide","stacked"],"type":"string"},"position":{"description":"Which side of the reference block it lands on. above and below need a reference block in a \u003cgrid\u003e, where before and after are its left and right.","enum":["before","after","above","below"],"type":"string"},"reference_block_uid":{"description":"The id of the block it lands beside.","type":"string"}},"required":["document_id","branch_id","block_uid","position","reference_block_uid"],"type":"object"},"name":"move_block"},"query_data_source":{"desc":"Run a query over a time range. Use PromQL for Prometheus, a LogQL log query for Loki and read-only SQL for the others. In SQL, $__ macros such as $__timeFilter expand against the range. Without chart_type it returns the raw answer: at most 20 series of 100 points, 200 rows, or the newest 100 logs. Each log has its time, level, message, labels and fields. has_more says older logs matched, so narrow the query or the range to see them. With chart_type it returns what a metric block would draw: status, series count, and each series' labels, point count and endpoints. Check a query that way before you put it in a block.","has_params_one_of":true,"json_schema":{"properties":{"chart_type":{"description":"The chart to check the query against. Leave it out for the values themselves. Not for Loki.","enum":["line_chart","bar_chart","gauge_chart"],"type":"string"},"data_source_id":{"description":"The data source id, from list_data_sources.","type":"string"},"from":{"description":"The range start, RFC 3339. Defaults to an hour before to.","type":"string"},"query":{"description":"The PromQL, LogQL or SQL to run. In LogQL, only labels go inside {}. A field parsed from the line needs | json or | logfmt before its filter, and detected_level goes after the selector, as in | detected_level=\"error\". For a SQL chart, select a time column aliased time and one or more numeric columns.","type":"string"},"to":{"description":"The range end, RFC 3339. Defaults to now.","type":"string"}},"required":["data_source_id","query"],"type":"object"},"name":"query_data_source"},"read_tool_output":{"desc":"Return the full output of an earlier tool call that was too large to keep in the conversation.","has_params_one_of":true,"json_schema":{"properties":{"file_path":{"description":"The path shown in the truncation notice.","type":"string"}},"required":["file_path"],"type":"object"},"name":"read_tool_output"},"replace_blocks":{"desc":"Replace one block with the blocks in content, in the XML insert_blocks describes. Returns the written blocks as XML. Read the block with get_document first, with block_uid to narrow the read, then edit the XML and send it back. Keep the id of every element that stays, so it keeps its comments, hooks and files, and unchanged content stays as stored. An element without an id is new. An id from outside the replaced block is refused, and so is a \u003cgrid\u003e.","has_params_one_of":true,"json_schema":{"properties":{"block_uid":{"description":"The id of the block being replaced.","type":"string"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"content":{"description":"The blocks that take its place, in the XML insert_blocks describes.","type":"string"},"document_id":{"description":"The document id.","type":"string"}},"required":["document_id","branch_id","block_uid","content"],"type":"object"},"name":"replace_blocks"},"search_documents":{"desc":"Search document titles and block text across every branch of every document. Returns {documents: [{document_id, document_name, branch_id, branch_name, default, protected, title_match, hits: [{block_uid, text}]}]}, best match first. A title or block matches when it holds all but one of the query's words, and typos are allowed. So search for a title or a phrase, not both, and check document_name. title_match says the title matched. Each hit is the innermost block holding the text, and get_document with its block_uid reads the element that holds it. A block a fork copied unchanged is found on every branch that holds it.","has_params_one_of":true,"json_schema":{"properties":{"limit":{"default":20,"description":"The most hits to return.","maximum":50,"type":"integer"},"query":{"description":"The title or phrase to search for.","maxLength":200,"type":"string"}},"required":["query"],"type":"object"},"name":"search_documents"},"set_tag_assignment":{"desc":"Put a tag on one branch of a document, or take it off. Returns {document_id, branch_id, tag_id, assigned}. The sidebar lists the document under the tag while its default branch carries it. Setting what is already the case changes nothing. delete_tag removes a tag everywhere.","has_params_one_of":true,"json_schema":{"properties":{"assigned":{"description":"true puts the tag on the branch, false takes it off.","type":"boolean"},"branch_id":{"description":"The branch id, from list_documents, search_documents or get_document. A protected branch refuses writes.","type":"string"},"document_id":{"description":"The document id.","type":"string"},"tag_id":{"description":"The tag id, from list_tags or a document's tags.","type":"string"}},"required":["document_id","branch_id","tag_id","assigned"],"type":"object"},"name":"set_tag_assignment"},"set_variable_value":{"desc":"Set the current user's own value of a global variable, built-ins included. With default it resets that value, so the user sees the default again. Set metric_range to show every chart over another period. A list takes an option id, a number a decimal, a time range a preset such as last_24_hours, and text anything. Returns {variable_id, value, default}.","has_params_one_of":true,"json_schema":{"properties":{"default":{"default":false,"description":"True resets the user's own value to the default.","type":"boolean"},"value":{"description":"The new value. Required unless default is true.","type":"string"},"variable_id":{"description":"The variable id, from list_variables.","type":"string"}},"required":["variable_id"],"type":"object"},"name":"set_variable_value"},"update_document":{"desc":"Change a document's name, icon or parent. Returns {document_id} and the fields that changed. Give only what changes, but give at least one. Content is not touched. A parent that is the document itself or one of its descendants is refused.","has_params_one_of":true,"json_schema":{"properties":{"document_id":{"description":"The document id.","type":"string"},"icon":{"description":"An Iconify id from the icon picker, mostly MingCute fills such as mingcute:rocket-fill. Another id is refused, and the error names the closest ones.","type":"string"},"name":{"description":"The new display name.","type":"string"},"parent_id":{"description":"The new parent document id. An empty string moves the document to the organisation root.","type":"string"}},"required":["document_id"],"type":"object"},"name":"update_document"},"update_hook":{"desc":"Reset a hook to a fresh hook's state and return it as list_hooks does. It is then untriggered, but a reminder already past its schedule stays triggered until settings give it a later one. Without settings the hook keeps its own, so call it that way once the document is up to date with what the hook flagged. New settings replace the old ones whole, so send their type too. It must be the hook's own type, so to change it, delete the hook and create another.","has_params_one_of":true,"json_schema":{"properties":{"document_id":{"description":"The document id.","type":"string"},"hook_id":{"description":"The hook id, from list_hooks.","type":"string"},"settings":{"description":"New settings in create_hook's shape, type included.","type":"object"}},"required":["document_id","hook_id"],"type":"object"},"name":"update_hook"},"update_tag":{"desc":"Rename, recolour or move a tag in the sidebar order, giving only what changes. Returns {tag_id} with what changed. A new name must be unused, and a call that changes nothing is refused. set_tag_assignment changes which documents carry it.","has_params_one_of":true,"json_schema":{"properties":{"color":{"description":"The new colour.","enum":["red","orange","amber","yellow","lime","green","emerald","teal","cyan","sky","blue","indigo","violet","purple","fuchsia","pink"],"type":"string"},"name":{"description":"The new display name.","type":"string"},"sort_index":{"description":"The 0-based position in list_tags order.","minimum":0,"type":"integer"},"tag_id":{"description":"The tag id, from list_tags or a document's tags.","type":"string"}},"required":["tag_id"],"type":"object"},"name":"update_tag"},"update_variable":{"desc":"Change a global variable and return {variable_id}. Give only what changes. A type change resets everyone's value. New options replace a list's options, and users who picked a removed value see the default again. A built-in variable takes only a new default.","has_params_one_of":true,"json_schema":{"properties":{"default":{"description":"The value everyone sees until they pick their own: a decimal, a time range preset or text. Not for a list, except a built-in one, which takes an option id.","type":"string"},"description":{"description":"The new description. An empty string clears it.","type":"string"},"group_id":{"description":"The group to move the variable to, at its end.","type":"string"},"key":{"description":"The new key, without the $.","type":"string"},"name":{"description":"The new display name.","type":"string"},"options":{"description":"A list's new option values in order.","items":{"type":"string"},"type":"array"},"type":{"description":"The new kind of value.","enum":["list","number","text","time-range"],"type":"string"},"variable_id":{"description":"The variable id, from list_variables.","type":"string"}},"required":["variable_id"],"type":"object"},"name":"update_variable"},"update_variable_group":{"desc":"Rename or recolour a variable group other than the built-in one. Give only what changes. Returns {group_id}.","has_params_one_of":true,"json_schema":{"properties":{"color":{"description":"The new colour.","enum":["red","orange","amber","yellow","lime","green","emerald","teal","cyan","sky","blue","indigo","violet","purple","fuchsia","pink"],"type":"string"},"group_id":{"description":"The variable group id, from list_variables.","type":"string"},"name":{"description":"The new display name.","type":"string"}},"required":["group_id"],"type":"object"},"name":"update_variable_group"}}