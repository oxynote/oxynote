{"append_block": {"desc": "Append a single canonical block at the end of a document. Block uid is generated server-side if omitted.", "has_params_one_of": true, "json_schema": {"properties": {"block": {"description": "A canonical block. See the system prompt for the per-type schema.", "properties": {"attrs": {"type": "object"}, "children": {"type": "array"}, "header": {"type": "string"}, "items": {"type": "array"}, "left": {"type": "array"}, "params": {"type": "array"}, "right": {"type": "array"}, "task_items": {"type": "array"}, "text": {"type": "string"}, "type": {"type": "string"}, "uid": {"type": "string"}}, "required": ["type"], "type": "object"}, "document_id": {"description": "The target document id.", "type": "string"}}, "required": ["document_id", "block"], "type": "object"}, "name": "append_block"}, "create_document": {"desc": "Create a new document. Returns {document_id, branch_id}. The document starts with one empty paragraph; immediately follow up with append_block / insert_block calls to populate it.", "has_params_one_of": true, "json_schema": {"properties": {"icon": {"description": "Lucide icon identifier (e.g. \"lucide:file-text\"). Defaults to \"lucide:file\" when empty.", "type": "string"}, "name": {"description": "Display name for the new document.", "type": "string"}, "parent_id": {"description": "Optional parent document id. Omit to create at the org root.", "type": "string"}}, "required": ["name"], "type": "object"}, "name": "create_document"}, "delete_block": {"desc": "Delete a block from the document by uid. This is destructive \u2014 the user is always asked to confirm and there is no auto-approve.", "has_params_one_of": true, "json_schema": {"properties": {"block_uid": {"description": "The uid of the block to delete.", "type": "string"}, "document_id": {"description": "The target document id.", "type": "string"}}, "required": ["document_id", "block_uid"], "type": "object"}, "name": "delete_block"}, "delete_document": {"desc": "Delete a document. This is destructive \u2014 the user is always asked to confirm and there is no auto-approve.", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document id to delete.", "type": "string"}}, "required": ["document_id"], "type": "object"}, "name": "delete_document"}, "get_document": {"desc": "Fetch metadata for one document: name, icon, parent_id, default branch id, protected flag, updated_at.", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document id.", "type": "string"}}, "required": ["document_id"], "type": "object"}, "name": "get_document"}, "get_prometheus_metadata": {"desc": "List the metrics a Prometheus data source exposes, with each metric's type, help text and unit. Use it to find the metric names to write a PromQL query against instead of guessing them.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}}, "required": ["data_source_id"], "type": "object"}, "name": "get_prometheus_metadata"}, "get_sql_metadata": {"desc": "List the tables and their columns in a PostgreSQL, MariaDB or MySQL data source, plus the default schema. Read it before writing a query so the table and column names are the real ones.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}}, "required": ["data_source_id"], "type": "object"}, "name": "get_sql_metadata"}, "get_sql_query_labels": {"desc": "Run a SQL query limited to one row and return its string columns with an example value each \u2014 the columns a chart would treat as series labels. Cheaper than query_sql for checking what a query returns.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "query": {"description": "The SQL query to probe. $__ macros are expanded as they are for a metric block.", "type": "string"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id", "query"], "type": "object"}, "name": "get_sql_query_labels"}, "insert_block": {"desc": "Insert a single canonical block before or after a referenced block in the document. The reference block stays in place. Block uid is generated server-side if omitted.", "has_params_one_of": true, "json_schema": {"properties": {"block": {"description": "A canonical block. See the system prompt for the per-type schema.", "properties": {"attrs": {"type": "object"}, "children": {"type": "array"}, "header": {"type": "string"}, "items": {"type": "array"}, "left": {"type": "array"}, "params": {"type": "array"}, "right": {"type": "array"}, "task_items": {"type": "array"}, "text": {"type": "string"}, "type": {"type": "string"}, "uid": {"type": "string"}}, "required": ["type"], "type": "object"}, "document_id": {"description": "The target document id.", "type": "string"}, "position": {"description": "Insert side relative to the reference block.", "enum": ["before", "after"], "type": "string"}, "reference_block_uid": {"description": "The uid of the block to insert relative to.", "type": "string"}}, "required": ["document_id", "reference_block_uid", "position", "block"], "type": "object"}, "name": "insert_block"}, "list_data_sources": {"desc": "List the organisation's data sources. Returns id, name, type (prometheus, postgresql, mariadb, mysql) and connection status. Start here: every other data-source tool takes an id from this list, and the type decides which of them serves it.", "has_params_one_of": true, "json_schema": {"properties": {}, "type": "object"}, "name": "list_data_sources"}, "list_documents": {"desc": "List documents in the organisation. Returns the document tree (id, name, icon, children). Use parent_id to list only the direct children of that document; omit to list the whole org.", "has_params_one_of": true, "json_schema": {"properties": {"parent_id": {"description": "Optional. Only return the direct children of this parent id. Omit for the full tree.", "type": "string"}}, "type": "object"}, "name": "list_documents"}, "list_prometheus_label_names": {"desc": "List the label names present in a Prometheus data source, optionally only those on the series the matchers select. Pair it with list_prometheus_label_values to build a filtered PromQL query.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "matchers": {"description": "Optional. PromQL series selectors, e.g. [\"up\", \"{job=\\\"api\\\"}\"].", "items": {"type": "string"}, "type": "array"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id"], "type": "object"}, "name": "list_prometheus_label_names"}, "list_prometheus_label_values": {"desc": "List the values a label takes in a Prometheus data source, optionally only on the series the matchers select. Use it to discover the concrete label values a query should filter on.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "label": {"description": "The label whose values to list, e.g. \"job\".", "type": "string"}, "matchers": {"description": "Optional. PromQL series selectors, e.g. [\"up\", \"{job=\\\"api\\\"}\"].", "items": {"type": "string"}, "type": "array"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id", "label"], "type": "object"}, "name": "list_prometheus_label_values"}, "list_prometheus_series": {"desc": "List the series matching a set of selectors in a Prometheus data source, each as its full label set. Use it to see which label combinations a metric actually has before querying it.", "has_params_one_of": true, "json_schema": {"properties": {"data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "matchers": {"description": "PromQL series selectors, e.g. [\"up\", \"{job=\\\"api\\\"}\"].", "items": {"type": "string"}, "type": "array"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id", "matchers"], "type": "object"}, "name": "list_prometheus_series"}, "move_block": {"desc": "Move an existing block before or after a referenced block in the document. The block keeps its uid, attrs, and nested content, so comments and hooks attached to it stay attached \u2014 always move a block this way rather than deleting it and inserting a copy.", "has_params_one_of": true, "json_schema": {"properties": {"block_uid": {"description": "The uid of the block to move.", "type": "string"}, "document_id": {"description": "The target document id.", "type": "string"}, "position": {"description": "Landing side relative to the reference block.", "enum": ["before", "after"], "type": "string"}, "reference_block_uid": {"description": "The uid of the block to move relative to.", "type": "string"}}, "required": ["document_id", "block_uid", "position", "reference_block_uid"], "type": "object"}, "name": "move_block"}, "move_document": {"desc": "Re-parent a document. Omit new_parent_id to move the document to the org root.", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document to move.", "type": "string"}, "new_parent_id": {"description": "Optional new parent document id; omit to move to the root.", "type": "string"}}, "required": ["document_id"], "type": "object"}, "name": "move_document"}, "prepend_block": {"desc": "Prepend a single canonical block at the start of a document. Block uid is generated server-side if omitted.", "has_params_one_of": true, "json_schema": {"properties": {"block": {"description": "A canonical block. See the system prompt for the per-type schema.", "properties": {"attrs": {"type": "object"}, "children": {"type": "array"}, "header": {"type": "string"}, "items": {"type": "array"}, "left": {"type": "array"}, "params": {"type": "array"}, "right": {"type": "array"}, "task_items": {"type": "array"}, "text": {"type": "string"}, "type": {"type": "string"}, "uid": {"type": "string"}}, "required": ["type"], "type": "object"}, "document_id": {"description": "The target document id.", "type": "string"}}, "required": ["document_id", "block"], "type": "object"}, "name": "prepend_block"}, "query_prometheus": {"desc": "Run a PromQL range query against a Prometheus data source over the given window. Returns the raw result by default, or the series a metric block would render when chart_type is set.", "has_params_one_of": true, "json_schema": {"properties": {"chart_type": {"description": "Optional. One of line_chart, bar_chart, gauge_chart. When set, the result is the transformed series the metric block renders, plus a status, instead of the raw result \u2014 use it to check a query before putting it in a metric block.", "type": "string"}, "data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "query": {"description": "The PromQL expression to run.", "type": "string"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id", "query"], "type": "object"}, "name": "query_prometheus"}, "query_sql": {"desc": "Run a read-only query against a PostgreSQL, MariaDB or MySQL data source. Returns columns and rows by default, or the series a metric block would render when chart_type is set. $__ macros ($__timeFilter, $__timeGroupAlias, \u2026) are expanded against the window, and the row count is capped.", "has_params_one_of": true, "json_schema": {"properties": {"chart_type": {"description": "Optional. One of line_chart, bar_chart, gauge_chart. When set, the result is the transformed series the metric block renders, plus a status, instead of the raw result \u2014 use it to check a query before putting it in a metric block.", "type": "string"}, "data_source_id": {"description": "The data source id, from list_data_sources.", "type": "string"}, "from": {"description": "Optional. Range start as an RFC3339 timestamp. Defaults to an hour before 'to'.", "type": "string"}, "query": {"description": "The SQL query to run. For a chart, select a time column aliased \"time\" plus one or more numeric columns.", "type": "string"}, "to": {"description": "Optional. Range end as an RFC3339 timestamp. Defaults to now.", "type": "string"}}, "required": ["data_source_id", "query"], "type": "object"}, "name": "query_sql"}, "read_block": {"desc": "Return the full canonical content of one block by uid, including any nested children. Use this only when read_document_summary doesn't carry enough detail (e.g. you need the full structure of a split_doc or split_doc_param_list to edit it).", "has_params_one_of": true, "json_schema": {"properties": {"block_uid": {"description": "The block uid to fetch.", "type": "string"}, "document_id": {"description": "The document id.", "type": "string"}}, "required": ["document_id", "block_uid"], "type": "object"}, "name": "read_block"}, "read_document_summary": {"desc": "Return an ordered, compact summary of a document: per-block uid, kind, flattened source_text, surrounding_context (ancestor headings, list intro, doc title), and tags. Use this as your default way to read a document \u2014 it's ~5-10x cheaper than fetching full content.", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document id.", "type": "string"}}, "required": ["document_id"], "type": "object"}, "name": "read_document_summary"}, "read_tool_output": {"desc": "Retrieve the full output of an earlier tool call that was too large to keep in the conversation. Pass the path shown in the truncation notice.", "has_params_one_of": true, "json_schema": {"properties": {"file_path": {"description": "The stored output path from the truncation notice.", "type": "string"}}, "required": ["file_path"], "type": "object"}, "name": "read_tool_output"}, "rename_document": {"desc": "Change a document's display name. The change is applied live via hocuspocus.", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document id.", "type": "string"}, "name": {"description": "The new display name.", "type": "string"}}, "required": ["document_id", "name"], "type": "object"}, "name": "rename_document"}, "replace_block": {"desc": "Replace an existing block by uid with a new block. The replacement keeps the same position in its parent. Useful for changing a block's type or its full structure. Block uid is generated server-side if omitted.", "has_params_one_of": true, "json_schema": {"properties": {"block": {"description": "A canonical block. See the system prompt for the per-type schema.", "properties": {"attrs": {"type": "object"}, "children": {"type": "array"}, "header": {"type": "string"}, "items": {"type": "array"}, "left": {"type": "array"}, "params": {"type": "array"}, "right": {"type": "array"}, "task_items": {"type": "array"}, "text": {"type": "string"}, "type": {"type": "string"}, "uid": {"type": "string"}}, "required": ["type"], "type": "object"}, "block_uid": {"description": "The uid of the block being replaced.", "type": "string"}, "document_id": {"description": "The target document id.", "type": "string"}}, "required": ["document_id", "block_uid", "block"], "type": "object"}, "name": "replace_block"}, "search_documents": {"desc": "Full-text search across all documents in the organisation for blocks whose text matches the query. Returns hits with document_id, document_name, block_uid, text. Use this to find relevant context before editing or to surface candidate documents the user might be asking about.", "has_params_one_of": true, "json_schema": {"properties": {"limit": {"description": "Maximum number of hits to return. Defaults to 20; cap is 50.", "type": "integer"}, "query": {"description": "The full-text search query (typo-tolerant, matches block text).", "type": "string"}}, "required": ["query"], "type": "object"}, "name": "search_documents"}, "set_document_icon": {"desc": "Change a document's icon identifier (Lucide-style, e.g. \"lucide:rocket\").", "has_params_one_of": true, "json_schema": {"properties": {"document_id": {"description": "The document id.", "type": "string"}, "icon": {"description": "The new icon identifier.", "type": "string"}}, "required": ["document_id", "icon"], "type": "object"}, "name": "set_document_icon"}, "update_block_attrs": {"desc": "Set or override the named attributes on an existing block. Unmentioned attributes are preserved; the uid attribute cannot be changed.", "has_params_one_of": true, "json_schema": {"properties": {"attrs": {"description": "Attribute keys and values to set (e.g. {\"level\": 2}, {\"icon\": \"lucide:warning\"}).", "type": "object"}, "block_uid": {"description": "The uid of the block whose attrs should be updated.", "type": "string"}, "document_id": {"description": "The target document id.", "type": "string"}}, "required": ["document_id", "block_uid", "attrs"], "type": "object"}, "name": "update_block_attrs"}, "update_block_text": {"desc": "Replace the inline text of a text-bearing block (paragraph, heading, blockquote, code, mermaid, callout-shorthand). The block's type and attrs are preserved. text uses the canonical minimal-markdown subset (**bold**, *italic*, _underline_, ~~strike~~, `code`, [label](url)). For code/mermaid blocks, text is raw and markdown is not parsed.", "has_params_one_of": true, "json_schema": {"properties": {"block_uid": {"description": "The uid of the block whose text should be replaced.", "type": "string"}, "document_id": {"description": "The target document id.", "type": "string"}, "text": {"description": "New inline text in canonical markdown.", "type": "string"}}, "required": ["document_id", "block_uid", "text"], "type": "object"}, "name": "update_block_text"}}