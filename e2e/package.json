{
	"name": "@oxynote/e2e",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"deps": "pnpm install",
		"setup": "pnpm run deps && playwright install chromium",
		"test:dev": "playwright test -c playwright.dev.config.ts",
		"test:prod": "playwright test -c playwright.prod.config.ts",
		"check-types": "tsc --noEmit",
		"eslint": "eslint --fix --max-warnings 0 .",
		"check-eslint": "eslint --max-warnings 0 .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix",
		"check-knip": "knip",
		"lint": "pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test:dev",
		"qa-fix": "pnpm run lint && pnpm run test:dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hocuspocus/provider": "^4.6.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.11.0",
		"knip": "^6.32.2",
		"prettier": "3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"ws": "^8.21.3"
	}
}
