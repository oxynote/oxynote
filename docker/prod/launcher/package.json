{
	"name": "@oxynote/launcher",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --minify \"--define:__SENTRY_WEB_DSN__=\\\"${SENTRY_WEB_DSN:-}\\\"\" \"--define:__SENTRY_CORE_DSN__=\\\"${SENTRY_CORE_DSN:-}\\\"\" \"--define:__SENTRY_AUTH_REALTIME_DSN__=\\\"${SENTRY_AUTH_REALTIME_DSN:-}\\\"\" \"--define:__SENTRY_LAUNCHER_DSN__=\\\"${SENTRY_LAUNCHER_DSN:-}\\\"\" \"--banner:js=import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outfile=dist/launcher.mjs",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache",
		"check-knip": "knip --cache",
		"test": "vitest run --coverage",
		"test-watch": "vitest",
		"lint": "pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"dependencies": {
		"@sentry/node": "^10.71.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/eslint-plugin": "^1.6.27",
		"esbuild": "^0.27.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"knip": "^6.32.2",
		"prettier": "3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	}
}
