# the single env template for the web app. `make setup` copies it to both
# web.local.env (read by the web container at start) and web/.env (auto-
# loaded by the host `nuxt dev` server and the electron builds). Every
# runtime-config variable the web app reads is listed explicitly, even when
# empty. `make dev` overrides NUXT_PUBLIC_APP_BASE_URL to the dev server's
# :3000 origin.

# public URLs (what the browser uses — the caddy front door)
NUXT_PUBLIC_APP_BASE_URL=http://localhost:8080
NUXT_PUBLIC_AUTH_REALTIME_API_BASE_HTTP_URL=http://localhost:8080/auth-realtime
NUXT_PUBLIC_AUTH_REALTIME_API_BASE_WS_URL=ws://localhost:8080/auth-realtime/hocuspocus
NUXT_PUBLIC_CORE_API_BASE_HTTP_URL=http://localhost:8080/core
NUXT_PUBLIC_CORE_API_BASE_WS_URL=ws://localhost:8080/core

# optional
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_LINK_TO_MORE_INFO_ABOUT_PRODUCT=https://oxynote.io
NUXT_PUBLIC_TERMS_OF_SERVICE_URL=
NUXT_PUBLIC_PRIVACY_POLICY_URL=
NUXT_PUBLIC_EXPERIMENTAL_FEATURES=

# in-app documentation links
NUXT_PUBLIC_POSTGRESQL_READ_ONLY_USER_SETUP_GUIDE_URL=https://tableplus.com/blog/2018/04/postgresql-how-to-create-read-only-user.html
NUXT_PUBLIC_MYSQL_READ_ONLY_USER_SETUP_GUIDE_URL=https://guide.trevor.io/hc/en-us/articles/6843804879261-Creating-a-read-only-database-user-in-MySQL
NUXT_PUBLIC_MARIADB_READ_ONLY_USER_SETUP_GUIDE_URL=https://guide.trevor.io/hc/en-us/articles/6843804879261-Creating-a-read-only-database-user-in-MySQL
NUXT_PUBLIC_PROMETHEUS_QUERY_GUIDE_URL=https://prometheus.io/docs/prometheus/latest/querying/basics/
NUXT_PUBLIC_POSTGRESQL_QUERY_GUIDE_URL=https://www.postgresql.org/docs/current/sql-select.html
NUXT_PUBLIC_MYSQL_QUERY_GUIDE_URL=https://dev.mysql.com/doc/refman/8.0/en/select.html
NUXT_PUBLIC_MARIADB_QUERY_GUIDE_URL=https://mariadb.com/kb/en/select/

# build-time secret for the Sentry build plugin (source map upload); not
# runtime config.
SENTRY_AUTH_TOKEN=
