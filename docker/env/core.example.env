# every variable core reads is listed here explicitly, even when empty.
# `make setup` copies this template to core.local.env (gitignored) when
# missing; the dev compose reads only the .local.env file — put secrets
# and local tweaks there.

# infrastructure wiring (compose service hostnames)
OXYNOTE_CORE_DB_DSN=postgresql://devuser:devpass@postgres/devdb?sslmode=disable
OXYNOTE_CORE_MEILISEARCH_DSN=http://meilisearch:7700
OXYNOTE_CORE_MEILISEARCH_MASTER_KEY=devmasterkey
OXYNOTE_CORE_VALKEY_NETWORK=tcp
OXYNOTE_CORE_VALKEY_ADDRESS=valkey:6379
OXYNOTE_CORE_STORAGE_URL=http://minio:9000
OXYNOTE_CORE_STORAGE_ACCESS_KEY=sparta
OXYNOTE_CORE_STORAGE_SECRET_KEY=chad_warrior
OXYNOTE_CORE_STORAGE_BUCKET=dev
OXYNOTE_CORE_SERVER_AUTH_BETTER_AUTH_URL=http://auth-realtime:8081/api/auth/get-session
OXYNOTE_CORE_SERVER_MCP_SESSION_URL=http://auth-realtime:8081/api/internal/mcp/session
OXYNOTE_CORE_AUTH_REALTIME_URL=http://auth-realtime:8081
OXYNOTE_CORE_SERVER_DEMO_PROMETHEUS_URL=http://prometheus:9090
OXYNOTE_CORE_CHANGEDETECTION_API_URL=http://changedetection:5000
# auto-populated in core.local.env by make run/start/dev (see
# docker/sync-changedetection-key.sh) — no need to fill in manually.
OXYNOTE_CORE_CHANGEDETECTION_API_KEY=

# public URLs (the caddy front door)
OXYNOTE_CORE_SERVER_PUBLIC_URL=http://localhost:8080/core
OXYNOTE_CORE_BASE_APP_URL=http://localhost:8080
# the canonical MCP resource URL (must match auth-realtime's MCP_RESOURCE).
OXYNOTE_CORE_SERVER_MCP_RESOURCE_URL=http://localhost:8080/core/api/mcp
OXYNOTE_CORE_ORIGINS=http://localhost:8080,localhost:8080,http://localhost:3000,localhost:3000

# Integrations. All of them are optional and degrade gracefully when empty.
# To enable the GitHub App, set GITHUB_APP_ID and drop the app's private key
# into docker/github/oxynote.private-key.pem; an empty GITHUB_APP_ID disables
# the integration entirely. To enable Slack, set all SLACK_* values; an empty
# SLACK_CLIENT_ID disables it.
#
# Both apps deliver to the public callback surface, which they must be
# configured to call (BASE_APP_URL + the path below):
#   github webhook url:   /core/api/apps/github/events
#   slack request url:    /core/api/apps/slack/events
#   slack command urls:   /core/api/apps/slack/commands and /slash
#   slack direct install: /core/api/apps/slack/install
# SLACK_REDIRECT_URL below is different: it points at the frontend page that
# finishes the in-app connect flow, not at core.
OXYNOTE_CORE_GITHUB_APP_ID=
OXYNOTE_CORE_GITHUB_APP_SLUG=
OXYNOTE_CORE_GITHUB_SIGNATURE_SECRET=
OXYNOTE_CORE_GITHUB_CLIENT_SECRET=
OXYNOTE_CORE_GITHUB_INSTALLATION_SIGNING_SECRET=
OXYNOTE_CORE_GITHUB_PRIVATE_KEY_PATH=/etc/oxynote/core/github/oxynote.private-key.pem
OXYNOTE_CORE_SLACK_CLIENT_ID=
OXYNOTE_CORE_SLACK_CLIENT_SECRET=
OXYNOTE_CORE_SLACK_SIGNATURE_SECRET=
OXYNOTE_CORE_SLACK_REDIRECT_URL=http://localhost:8080/slack
OXYNOTE_CORE_SLACK_INSTALLATION_SIGNING_SECRET=
# AI assistant. PROVIDER selects the vendor: claude, openai, gemini,
# ollama, or openrouter. MODEL is passed to the provider verbatim, so use
# that vendor's own identifier. Both are required; core refuses to start
# without them.
#
# The assistant is entirely tool-driven, so the model must be reliable at
# calling tools against a large schema. Known-good choices per provider
# are listed in the README; small local models generally are not.
OXYNOTE_CORE_ASSISTANT_PROVIDER=claude
OXYNOTE_CORE_ASSISTANT_MODEL=claude-opus-4-6
OXYNOTE_CORE_ASSISTANT_API_KEY=
# optional. Overrides the provider endpoint. Required for ollama, and the
# way to reach any OpenAI-compatible server with PROVIDER=openai.
OXYNOTE_CORE_ASSISTANT_BASE_URL=
# optional. Caps one reply and bounds one request to the provider.
OXYNOTE_CORE_ASSISTANT_MAX_TOKENS=64000
OXYNOTE_CORE_ASSISTANT_REQUEST_TIMEOUT=10m
# optional. Summarising a long conversation is mechanical work; point it
# at a cheaper model to avoid paying chat rates for it. Defaults to MODEL.
OXYNOTE_CORE_ASSISTANT_SUMMARY_MODEL=
# optional, PROVIDER=openai only: set to target Azure OpenAI.
OXYNOTE_CORE_ASSISTANT_AZURE_API_VERSION=
# optional, PROVIDER=claude only: set REGION to reach Claude via AWS
# Bedrock. Leave the keys empty to use the ambient AWS credential chain.
OXYNOTE_CORE_ASSISTANT_BEDROCK_REGION=
OXYNOTE_CORE_ASSISTANT_BEDROCK_ACCESS_KEY=
OXYNOTE_CORE_ASSISTANT_BEDROCK_SECRET_ACCESS_KEY=
OXYNOTE_CORE_ASSISTANT_BEDROCK_SESSION_TOKEN=
# optional, PROVIDER=claude only: set PROJECT_ID to reach Claude via
# Google Vertex. Leave the service account empty to use application
# default credentials.
OXYNOTE_CORE_ASSISTANT_VERTEX_PROJECT_ID=
OXYNOTE_CORE_ASSISTANT_VERTEX_REGION=
OXYNOTE_CORE_ASSISTANT_VERTEX_SERVICE_ACCOUNT_JSON=

# document changelog retention. Snapshots pin the files they reference, so
# these bounds also decide how long a removed image survives. 0 disables
# the respective bound.
OXYNOTE_CORE_DB_MAX_DOCUMENT_CHANGELOGS=100
OXYNOTE_CORE_DB_DOCUMENT_CHANGELOG_RETENTION=2160h

# secrets
OXYNOTE_CORE_DB_DATA_SOURCE_CREDENTIALS_SIGNING_SECRET=devsigningsecret

# email
OXYNOTE_CORE_EMAIL_SMTP_HOST=mailpit
OXYNOTE_CORE_EMAIL_SMTP_PORT=1025
OXYNOTE_CORE_EMAIL_SMTP_USERNAME=
OXYNOTE_CORE_EMAIL_SMTP_PASSWORD=
OXYNOTE_CORE_EMAIL_SMTP_TLS=none
OXYNOTE_CORE_EMAIL_FROM_ADDRESS=Oxynote <team@oxynote.io>
