# every variable core reads is listed here explicitly, even when empty.
# `make setup` copies this template to core.local.env (gitignored) when
# missing; the dev compose reads only the .local.env file — put secrets
# and local tweaks there.

# infrastructure wiring (compose service hostnames)
OXYNOTE_CORE_DB_DSN=postgresql://devuser:devpass@postgres/devdb?sslmode=disable
OXYNOTE_CORE_MEILISEARCH_DSN=http://meilisearch:7700
OXYNOTE_CORE_MEILISEARCH_MASTER_KEY=devmasterkey
OXYNOTE_CORE_VALKEY_NETWORK=tcp
OXYNOTE_CORE_VALKEY_ADDRESS=valkey:6379
OXYNOTE_CORE_STORAGE_URL=http://minio:9000
OXYNOTE_CORE_STORAGE_ACCESS_KEY=sparta
OXYNOTE_CORE_STORAGE_SECRET_KEY=chad_warrior
OXYNOTE_CORE_STORAGE_BUCKET=dev
OXYNOTE_CORE_SERVER_AUTH_BETTER_AUTH_URL=http://auth-realtime:8081/api/auth/get-session
OXYNOTE_CORE_NODE_URL=http://auth-realtime:8081
OXYNOTE_CORE_CONNECTOR_URL=http://connector:8080
OXYNOTE_CORE_SERVER_DEMO_PROMETHEUS_URL=http://prometheus:9090
OXYNOTE_CORE_CHANGEDETECTION_API_URL=http://changedetection:5000
OXYNOTE_CORE_CHANGEDETECTION_API_KEY=

# public URLs (the caddy front door)
OXYNOTE_CORE_SERVER_PUBLIC_URL=http://localhost:8081/go
OXYNOTE_CORE_BASE_APP_URL=http://localhost:8081
OXYNOTE_CORE_ORIGINS=http://localhost:8081,localhost:8081

# Integrations. All of them are optional and degrade gracefully when empty.
# To enable the GitHub App, set GITHUB_APP_ID and drop the app's private key
# into docker/github/oxynote.private-key.pem; an empty GITHUB_APP_ID disables
# the integration entirely. To enable Slack, set all SLACK_* values; an empty
# SLACK_CLIENT_ID disables it.
OXYNOTE_CORE_GITHUB_APP_ID=
OXYNOTE_CORE_GITHUB_APP_SLUG=
OXYNOTE_CORE_GITHUB_SIGNATURE_SECRET=
OXYNOTE_CORE_GITHUB_CLIENT_SECRET=
OXYNOTE_CORE_GITHUB_INSTALLATION_SIGNING_SECRET=
OXYNOTE_CORE_GITHUB_PRIVATE_KEY_PATH=/etc/oxynote/core/github/oxynote.private-key.pem
OXYNOTE_CORE_SLACK_CLIENT_ID=
OXYNOTE_CORE_SLACK_CLIENT_SECRET=
OXYNOTE_CORE_SLACK_SIGNATURE_SECRET=
OXYNOTE_CORE_SLACK_REDIRECT_URL=http://localhost:8081/slack
OXYNOTE_CORE_SLACK_INSTALLATION_SIGNING_SECRET=
OXYNOTE_CORE_ANTHROPIC_API_KEY=

# secrets
OXYNOTE_CORE_DB_DATA_SOURCE_CREDENTIALS_SIGNING_SECRET=devsigningsecret

# email
OXYNOTE_CORE_EMAIL_MAILGUN_DOMAIN=
OXYNOTE_CORE_EMAIL_MAILGUN_API_KEY=
OXYNOTE_CORE_EMAIL_MAILGUN_TEMPLATE_ORGANIZATION_INVITATION_KEY=organization-invite
OXYNOTE_CORE_EMAIL_MAILGUN_TEMPLATE_EMAIL_VERIFICATION_KEY=email-verification
OXYNOTE_CORE_EMAIL_MAILGUN_TEMPLATE_USER_DELETION_KEY=user-deletion
OXYNOTE_CORE_EMAIL_MAILGUN_TEMPLATE_USER_CREATION_KEY=user-creation
OXYNOTE_CORE_EMAIL_FROM_ADDRESS=Oxynote <team@oxynote.io>
