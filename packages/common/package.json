{
	"name": "@oxynote/common",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		"./grid": "./src/grid.ts",
		"./schema-version": "./src/schema-version.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache",
		"check-knip": "knip --cache",
		"test": "vitest run --coverage",
		"test-watch": "vitest",
		"bench": "vitest bench --run --passWithNoTests --reporter=default",
		"lint": "pnpm dedupe && pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm dedupe --check && pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/eslint-plugin": "^1.6.28",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.18.1",
		"knip": "^6.44.1",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
