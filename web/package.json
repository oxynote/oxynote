{
	"name": "oxynote",
	"version": "0.0.1",
	"productName": "Oxynote",
	"description": "Oxynote Desktop",
	"author": {
		"name": "Oxynote",
		"email": "hello@oxynote.io"
	},
	"private": true,
	"type": "module",
	"main": ".vite/build/main.cjs",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"setup": "pnpm run deps && pnpm run prepare && pnpm run deps:browsers",
		"deps": "pnpm install",
		"deps:browsers": "playwright install chromium",
		"build:web": "pnpm run build:lezer-promql && nuxt build",
		"start:dev:web": "nuxt dev",
		"start:dev:desktop": "DESKTOP_BUILD=hybrid concurrently -k -s first -n nuxt,electron -c blue,magenta \"nuxt dev --port 3000\" \"wait-on http://localhost:3000 && electron-forge start\"",
		"package:desktop": "DESKTOP_BUILD=1 nuxt generate && electron-forge package",
		"make:desktop": "DESKTOP_BUILD=1 nuxt generate && electron-forge make",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"prepare": "pnpm run build:lezer-promql && nuxt prepare",
		"build:lezer-promql": "pnpm --filter @oxynote/lezer-promql build",
		"check-types": "nuxt typecheck && tsc -p electron/tsconfig.json --noEmit",
		"eslint": "eslint --fix --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"check-eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint --cache-strategy content .",
		"fmt": "prettier --write .",
		"check-fmt": "prettier --check .",
		"knip": "knip --fix --allow-remove-files --cache",
		"check-knip": "knip --cache",
		"test": "vitest run --coverage",
		"test-watch": "vitest",
		"lint": "pnpm run check-types && pnpm run knip && pnpm run eslint && pnpm run fmt",
		"check-lint": "pnpm run check-types && pnpm run check-eslint && pnpm run check-fmt && pnpm run check-knip",
		"qa": "pnpm run check-lint && pnpm run test",
		"qa-fix": "pnpm run lint && pnpm run test"
	},
	"dependencies": {
		"@better-auth/electron": "^1.7.1",
		"@codemirror/lang-sql": "^6.10.0",
		"@floating-ui/dom": "^1.8.0",
